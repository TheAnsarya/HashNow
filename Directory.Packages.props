<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- Core dependencies -->
		<PackageVersion Include="StreamHash" Version="1.11.4" />
		<PackageVersion Include="System.Management" Version="10.0.12" />

		<!-- Test framework -->
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="coverlet.collector" Version="10.1.0" />

		<!-- Benchmark dependencies -->
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageVersion Include="Blake3" Version="3.0.2" />
		<PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageVersion Include="SauceControl.Blake2Fast" Version="2.0.0" />
	</ItemGroup>

</Project>
